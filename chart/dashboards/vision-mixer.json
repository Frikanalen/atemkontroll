    {
      "id": 7,
      "type": "state-timeline",
      "title": "What was on air",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "Program and preview over time. Gaps mean atemkontroll was not scraped or not connected.",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "expr": "max(atem_program_input{me=\"0\"})",
          "legendFormat": "Program",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "expr": "max(atem_preview_input{me=\"0\"})",
          "legendFormat": "Preview",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "expr": "max(atem_fade_to_black{me=\"0\"})",
          "legendFormat": "Fade to black",
          "refId": "C"
        }
      ],
      "options": {
        "showValue": "auto",
        "mergeValues": true,
        "rowHeight": 0.8,
        "alignValue": "left",
        "legend": {
          "showLegend": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": __INPUT_MAPPINGS__,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Fade to black"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Off",
                        "color": "transparent",
                        "index": 0
                      },
                      "-1": {
                        "text": "BLACK",
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
